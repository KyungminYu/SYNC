PORT=3001
LOG_LEVEL=info
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_DATABASE=sync-local
AGENT_MODE=deterministic
AGENT_MAX_CONCURRENCY=4
AGENT_TIMEOUT_MS=30000
# Optional: otherwise persisted in the ignored .local/agent-token file.
# SPACETIMEDB_TOKEN=
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

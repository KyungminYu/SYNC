# Public connection settings shared by dev, feeder, build, and database commands.
SPACETIME_URI=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=your-database-name
# Authenticate the publishing CLI with pnpm db:login.
# Never put authentication tokens in SPACETIME_URI or any VITE_* setting.
# Optional real worker supervisor; adapter and run ID must both be set.
# SYNC_AGENT_RUN_ID=123
# SYNC_AGENT_ADAPTER=adapters/my-agent.ts
# PORT=3001
